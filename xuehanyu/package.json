{
  "name": "fullstack-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready fullstack monorepo with React, Express, Prisma, and MySQL",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:backend": "npm run dev -w packages/backend",
    "build": "npm run build -w packages/frontend && npm run build -w packages/backend",
    "build:frontend": "npm run build -w packages/frontend",
    "build:backend": "npm run build -w packages/backend",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" --ignore-pattern node_modules",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --fix --ignore-pattern node_modules",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json,md}\"",
    "prisma:generate": "npm run prisma:generate -w packages/backend",
    "prisma:migrate": "npm run prisma:migrate -w packages/backend",
    "prisma:studio": "npm run prisma:studio -w packages/backend"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
